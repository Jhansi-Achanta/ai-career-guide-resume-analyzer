# ---------------------------------------------------------------------------
# TEMPLATE FILE - copy this file to ".env" and fill in your own values.
# Never put a real API key inside ".env.example" (it is safe to commit/share).
# ---------------------------------------------------------------------------

# Get a free Gemini API key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: the Gemini model used for every AI feature.
# Current stable fast/general-purpose model. Change it here (not in the code)
# if your key does not have access to this model.
GEMINI_MODEL=gemini-3.8-flash

# Optional: upload limits / server settings
MAX_UPLOAD_MB=5
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
